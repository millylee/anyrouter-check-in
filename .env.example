# AnyRouter 账号配置
#
# 邮箱密码登录（推荐）:
# ANYROUTER_ACCOUNTS=[{"email":"your@email.com","password":"your_password","api_user":"你的api_user值"}]
#
# Session 登录（兼容旧版）:
# ANYROUTER_ACCOUNTS=[{"cookies":{"session":"你的session值"},"api_user":"你的api_user值"}]
# 新版 Bearer token 登录（部分 NewAPI 站点已切换到 access_token）:
# ANYROUTER_ACCOUNTS=[{"access_token":"你的 access_token"}]
#
# 混合配置（邮箱密码优先，session 作为备选）:
# ANYROUTER_ACCOUNTS=[{"email":"your@email.com","password":"your_password","cookies":{"session":"你的session值"},"api_user":"你的api_user值"}]

ANYROUTER_ACCOUNTS=[{"email":"your@email.com","password":"your_password","api_user":"你的api_user值"}]

# 追加账号（格式同上）。加载顺序 ANYROUTER_ACCOUNTS -> EXTRA_ACCOUNTS -> EXTRA_ACCOUNTS_2 -> EXTRA_ACCOUNTS_3，
# 合并成一份列表；同名账号后者覆盖前者。分多个变量是因为 GitHub Secret 写入后读不出来，
# 新站点单独占一个编号才不会在改动时覆盖掉已有账号。
# EXTRA_ACCOUNTS=[{"name":"小鸡毛","provider":"xiaojimao","access_token":"xxx"}]
# Twinkle Model（Sub2API，推荐邮箱密码登录，每次任务自动换取短效 token）:
# EXTRA_ACCOUNTS_3=[{"name":"Twinkle-Dodo","provider":"twinkle","email":"you@example.com","password":"your_password"}]
# 也可以只保存 refresh_token：
# EXTRA_ACCOUNTS_3=[{"name":"Twinkle-Dodo","provider":"twinkle","refresh_token":"xxx"}]
# 追加 Twinkle 邮箱密码账号（refresh_token 在 CI 里会轮换失效，优先用邮箱密码）：
# EXTRA_ACCOUNTS_33=[{"name":"Twinkle-112581647","provider":"twinkle","email":"you@example.com","password":"your_password"}]
# 42 API（https://api.42w.shop，NewAPI）：
# EXTRA_ACCOUNTS_5=[{"name":"42-Dodo","provider":"42w","cookies":{"session":"xxx"},"api_user":"你的用户ID"}]
# Kapibala（https://kapibala.asia，新版 NewAPI Bearer 认证）：
# EXTRA_ACCOUNTS_6=[{"name":"Kapibala-Dodo","provider":"kapibala","cookies":{"new_api_refresh":"xxx","session":"xxx"}}]
# 年华 API（https://us-3.nianhuaapi.com）：
# EXTRA_ACCOUNTS_9=[{"name":"Nianhua-Dodo","provider":"nianhua","username":"your_email","password":"your_password"}]
# SheApi（https://www.sheapi.top，需要本地 OCR 识别签到图片验证码）：
# EXTRA_ACCOUNTS_10=[{"name":"SheApi","provider":"sheapi","username":"your_username","password":"your_password"}]
# AIAIAI（https://api.aiaiai001.com，使用 Cookie 登录态）：
# EXTRA_ACCOUNTS_11=[{"name":"AIAIAI-thy1117","provider":"aiaiai","cookies":{"web_device_id":"xxx","session":"xxx"},"api_user":"2054"}]
# GuysCode（https://www.guyscode.com，Bearer access_token + refresh_token）：
# EXTRA_ACCOUNTS_12=[{"name":"GuysCode-thy1117","provider":"guyscode","access_token":"xxx","refresh_token":"rt_xxx"}]
# 小白 Code 外站签到（https://token.dialoguedui.com/checkin/，Bearer access_token + refresh_token）：
# EXTRA_ACCOUNTS_13=[{"name":"小白Code-112581647","provider":"xiaobai","access_token":"xxx","refresh_token":"xxx"}]
# 小鸡毛（https://api.ark717.com，Bearer access_token，可附带 session/cf_clearance）：
# EXTRA_ACCOUNTS_14=[{"name":"小鸡毛-thy1117","provider":"xiaojimao","access_token":"xxx","cookies":{"session":"xxx","cf_clearance":"xxx"}}]
# 清酒（https://qingjiu.nemodesk.top，用户名密码登录，签到走浏览器页内请求）：
# EXTRA_ACCOUNTS_16=[{"name":"清酒-thy1118","provider":"qingjiu","username":"your_username","password":"your_password"}]
# 词元站（https://ai.962831.xyz，系统访问令牌 + 用户 ID）：
# EXTRA_ACCOUNTS_19=[{"name":"词元站-thy1117","provider":"ciyuan","access_token":"xxx","api_user":"1174"}]
# 月城公益站（https://52ccl.net，系统访问令牌 + 用户 ID）：
# EXTRA_ACCOUNTS_20=[{"name":"月城公益站-thy1117","provider":"yuecheng","access_token":"xxx","api_user":"1936"}]
# 烁（https://elysiver.h-e.top，系统访问令牌 + 用户 ID）：
# EXTRA_ACCOUNTS_21=[{"name":"烁-thy1117","provider":"elysiver","access_token":"xxx","api_user":"32577"}]
# Ark API / WindHub（https://windhub.cc，系统访问令牌 + 用户 ID）：
# EXTRA_ACCOUNTS_22=[{"name":"WindHub-thy1117","provider":"windhub","access_token":"xxx","api_user":"28157"}]
# 老魔公益站（https://api.2020111.xyz，系统访问令牌 + 用户 ID，签到带 Turnstile）：
# EXTRA_ACCOUNTS_23=[{"name":"老魔公益站-thy1117","provider":"laomo","access_token":"xxx","api_user":"4703"}]
# 123NHH（https://api.123nhh.com，系统访问令牌 + 用户 ID）：
# EXTRA_ACCOUNTS_25=[{"name":"123NHH-thy1117","provider":"nhh123","access_token":"xxx","api_user":"3813"}]
# SuperAPI（https://superapi.buzz，系统访问令牌 + 用户 ID）：
# EXTRA_ACCOUNTS_26=[{"name":"SuperAPI-thy1117","provider":"superapi","access_token":"xxx","api_user":"8831"}]

# Gemai / 哈基米 API 站（https://api.gemai.cc，系统访问令牌 + 用户 ID，无 Turnstile）：
# EXTRA_ACCOUNTS_34=[{"name":"Gemai-account-1","provider":"gemai","access_token":"xxx","api_user":"your_user_id"}]

# 调试模式：true 时保存登录截图、输出代理地址/api_user 等详细日志（默认 false）
# DEBUG_MODE=false
# 每次签到任务完成都发送通知，即使额度没有变化（默认 true）
# NOTIFY_EVERY_RUN=true
# CHECKIN_BROWSER_PROFILE_DIR=.browser_profiles
# CLOAKBROWSER_BINARY_PATH=/path/to/local/browser

# 可选：Clash/Mihomo 订阅（CI 配 GitHub Secret PROXY_SUBSCRIPTION_URL；本地可先运行 scripts/setup_mihomo_proxy.sh）
# PROXY_SUBSCRIPTION_URL=https://example.com/sub?token=xxx
# CHECKIN_PROXY_URL=http://127.0.0.1:7890
# PROVIDERS 可按平台配置 use_proxy（内置默认 anyrouter=false, agentrouter=true）
# PROVIDERS={"agentrouter":{"domain":"https://agentrouter.org","use_proxy":true}}

# 可选：通知配置
# DINGDING_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
# EMAIL_USER=your_email@example.com
# EMAIL_PASS=your_password
# EMAIL_TO=recipient@example.com
# EMAIL_SENDER=
# PUSHPLUS_TOKEN=your_pushplus_token
# SERVERPUSHKEY=your_server_pushkey
# FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# WEIXIN_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
# GOTIFY_URL=https://your-gotify-server/message
# GOTIFY_TOKEN=your_gotify_token
# GOTIFY_PRIORITY=9
# BARK_KEY=your_bark_key
# BARK_SERVER=https://api.day.app
