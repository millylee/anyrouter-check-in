# AnyRouter 账号配置
#
# 邮箱密码登录（推荐）:
# ANYROUTER_ACCOUNTS=[{"email":"your@email.com","password":"your_password","api_user":"你的api_user值"}]
#
# Session 登录（兼容旧版）:
# ANYROUTER_ACCOUNTS=[{"cookies":{"session":"你的session值"},"api_user":"你的api_user值"}]
#
# 混合配置（邮箱密码优先，session 作为备选）:
# ANYROUTER_ACCOUNTS=[{"email":"your@email.com","password":"your_password","cookies":{"session":"你的session值"},"api_user":"你的api_user值"}]

ANYROUTER_ACCOUNTS=[{"email":"your@email.com","password":"your_password","api_user":"你的api_user值"}]

# 调试模式：true 时保存登录截图、输出代理地址/api_user 等详细日志（默认 false）
# DEBUG_MODE=false
# CHECKIN_BROWSER_PROFILE_DIR=.browser_profiles
# CLOAKBROWSER_BINARY_PATH=/path/to/local/browser

# 内置 provider：anyrouter（默认）、agentrouter、sotamodel、helpcoder、seekai、gorouter、justwoker、hcnsec、tabitoken
# sotamodel 走 JSON 接口登录，无需浏览器，签到入口为 /agents 页面底部的 Daily Check-in：
# ANYROUTER_ACCOUNTS=[{"provider":"sotamodel","email":"your@email.com","password":"your_password"}]

# NewAPI 六站签到（接口统一为 /api/user/checkin，每天一次），只填邮箱密码即可：
# ANYROUTER_ACCOUNTS=[{"provider":"helpcoder","email":"your@email.com","password":"your_password"},{"provider":"seekai","email":"your@email.com","password":"your_password"},{"provider":"gorouter","email":"your@email.com","password":"your_password"},{"provider":"justwoker","email":"your@email.com","password":"your_password"},{"provider":"hcnsec","email":"your@email.com","password":"your_password"},{"provider":"tabitoken","email":"your@email.com","password":"your_password"}]
#
# helpcoder、hcnsec 无 Turnstile，直接走 JSON 登录接口，不启动浏览器
# seekai、gorouter、justwoker、tabitoken 登录页有 Cloudflare Turnstile，需要 CloakBrowser 过校验
# seekai、gorouter、justwoker、hcnsec、tabitoken 的仪表盘只认 Authorization: Bearer，登录后自动获取 access_token
# tabitoken 的 Cloudflare WAF 较严，非浏览器 UA 会被 403，脚本已统一带浏览器 UA
#
# 也可以直接用浏览器里的 access_token（F12 → Application → Local Storage → new-api:auth-session）：
# ANYROUTER_ACCOUNTS=[{"provider":"hcnsec","access_token":"你的access_token"}]

# 可选：Clash/Mihomo 订阅（CI 配 GitHub Secret PROXY_SUBSCRIPTION_URL；本地可先运行 scripts/setup_mihomo_proxy.sh）
# PROXY_SUBSCRIPTION_URL=https://example.com/sub?token=xxx
# CHECKIN_PROXY_URL=http://127.0.0.1:7890
#
# 全部内置 provider 默认 use_proxy=true；未设置 CHECKIN_PROXY_URL 时只告警，仍会直连签到
# 想让某个站点不走代理，用 PROVIDERS 单独关掉（domain 必填）：
# PROVIDERS={"anyrouter":{"domain":"https://anyrouter.top","use_proxy":false}}
# 自定义 provider 默认 use_proxy=false，需要代理请显式写 true

# 可选：通知配置
# DINGDING_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
# EMAIL_USER=your_email@example.com
# EMAIL_PASS=your_password
# EMAIL_TO=recipient@example.com
# EMAIL_SENDER=
# PUSHPLUS_TOKEN=your_pushplus_token
# SERVERPUSHKEY=your_server_pushkey
# FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# WEIXIN_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
# GOTIFY_URL=https://your-gotify-server/message
# GOTIFY_TOKEN=your_gotify_token
# GOTIFY_PRIORITY=9
# BARK_KEY=your_bark_key
# BARK_SERVER=https://api.day.app
